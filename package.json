{
  "name": "autoheal",
  "version": "6.0.0",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "autoheal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "autoheal": "tsx src/cli.ts run",
    "autoheal:demo": "tsx src/cli.ts run --file demo/checkout.spec.ts --no-pr",
    "watch": "tsx src/cli.ts watch"
  },
  "keywords": [
    "playwright",
    "testing",
    "self-healing",
    "autonomous-agent",
    "ai",
    "ast-patching",
    "cypress",
    "testing-library",
    "flaky-tests",
    "vision-ai",
    "cache"
  ],
  "author": "Franca Roscilli <francaroscillidev@gmail.com> (https://github.com/francaroscillidev-gif)",
  "repository": {
    "type": "git",
    "url": "https://github.com/francaroscillidev-gif/autoheal.git"
  },
  "license": "Apache-2.0",
  "description": "Autonomous Testing & Regression Agent (Self-Healing Tests for Playwright, Cypress, Testing Library)",
  "dependencies": {
    "@playwright/test": "^1.50.0",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.0",
    "ts-morph": "^25.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
